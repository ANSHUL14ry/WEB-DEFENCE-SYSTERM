# AEGIS Ω Configuration

# Environment
AEGIS_ENV=development
AEGIS_VERSION=0.3.0-alpha
LOG_LEVEL=INFO

# Networking & Ports
AEGIS_GATEWAY_PORT=8080
AEGIS_DASHBOARD_PORT=3000
AEGIS_API_PORT=8001
AEGIS_ORIGIN_PORT=8088

# Gateway Hardening & Request Tracing (Phase 2)
GATEWAY_REQUEST_BODY_LIMIT=10M
GATEWAY_CONNECT_TIMEOUT=5s
GATEWAY_SEND_TIMEOUT=10s
GATEWAY_READ_TIMEOUT=10s

# Coraza WAF & OWASP CRS (Phase 3)
WAF_MODE=BLOCK
WAF_RULE_ENGINE=On
WAF_ENGINE=Coraza v3
CRS_VERSION=OWASP CRS v4.3.0
CORAZA_AUDIT_LOG_PATH=/var/log/coraza/audit.log

# PostgreSQL Database
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=aegis_secure_hackathon_pass_2026
POSTGRES_DB=aegis_security_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://aegis_admin:aegis_secure_hackathon_pass_2026@db:5432/aegis_security_db

# Security & CORS
SECRET_KEY=aegis_super_secret_jwt_key_defense_platform_2026
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Service URLs for Gateway proxying
API_SERVICE_URL=http://api:8000
WAF_SERVICE_URL=http://waf:8080
ORIGIN_SERVICE_URL=http://origin:8088
HONEYPOT_SERVICE_URL=http://honeypot:8090
